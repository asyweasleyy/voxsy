{
  "name": "voxsy",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node ./scripts/expo-cli-system-ca.js start",
    "android": "node ./scripts/expo-cli-system-ca.js start --android",
    "ios": "node ./scripts/expo-cli-system-ca.js start --ios",
    "web": "node ./scripts/expo-cli-system-ca.js start --web",
    "eas:login": "node ./scripts/eas-system-ca.js login",
    "eas:build:preview": "node ./scripts/eas-system-ca.js build --platform android --profile preview",
    "eas:build:production": "node ./scripts/eas-system-ca.js build --platform android --profile production",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --coverage --watchAll=false"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.16.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "@react-navigation/stack": "^7.9.0",
    "@supabase/supabase-js": "^2.105.4",
    "expo": "~54.0.33",
    "expo-av": "~16.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "private": true
}
